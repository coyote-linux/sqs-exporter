# Copy to: /etc/sqs-exporter/sqs-exporter.env
#
# ASP.NET Core-style config binding (double-underscore maps to ':')
# Example: Otlp__Endpoint => Otlp:Endpoint

# --- OTLP / SigNoz ---
Otlp__Endpoint=http://signoz.respage.internal:4317
Otlp__Protocol=grpc
Otlp__ServiceName=sqs-exporter
Otlp__DeploymentEnvironment=production
# Otlp__Headers=Authorization=Bearer yourtoken

# --- SQS exporter ---
SqsExporter__AwsRegion=us-east-1
SqsExporter__PollingIntervalSeconds=60
SqsExporter__AutoDiscoverQueues=true
SqsExporter__QueueDiscoveryRefreshSeconds=300
SqsExporter__MaxConcurrentAwsCalls=20
#
# Optional: limit discovery (recommended)
# SqsExporter__QueueNamePrefixes__0=prod-
# SqsExporter__QueueNamePrefixes__1=stage-


